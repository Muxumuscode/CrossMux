From 3680a5a0767cb854599ea11b39e834fbcfe18269 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 21:07:28 +0000
Subject: [PATCH] fix(lgfx-epd): one refresh per anti-aliased page (combined
 grayscale base)

LgfxEpdDriver declared a Separate grayscale base, so every anti-aliased page
took two full Panel_EPD refreshes: display() pushed the B/W page, then
displayGray() pushed it again with the gray overlay -- a visible double
flash on every T5 page turn.

Declare GrayscaleBase::Combined. beginGrayscale() now only stages the B/W
frame in the canvas (same fill, waveform choice, and clean-bank normalize
as display(), minus the push), and displayGray() pushes base + gray in one
refresh. If the gray pass is cancelled, cleanupGrayscaleBuffers() pushes
the staged B/W page so the panel never keeps the previous one; a plain
display() clears the staged state.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018voLFBnr1A2V962GEiL7Nk
---
 .../src/driver/LgfxEpdDriver.cpp              | 36 +++++++++++++++++--
 .../FreeInkDisplay/src/driver/LgfxEpdDriver.h |  6 +++-
 2 files changed, 39 insertions(+), 3 deletions(-)

diff --git a/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.cpp b/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.cpp
index f825dd9..104b3c6 100644
--- a/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.cpp
+++ b/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.cpp
@@ -219,6 +219,10 @@ void overlayCanvasGray() {
 // used to hardcode epd_fast while display() maps HALF/FULL to epd_text, so any
 // page refreshed with those modes flashed when its AA pass ran.
 lgfx::epd_mode::epd_mode_t g_lastBaseEpdMode = lgfx::epd_mode::epd_fast;
+// Combined grayscale: beginGrayscale() staged a B/W base in the canvas that has
+// NOT reached the panel yet. displayGray() pushes it with the gray overlay; a
+// cancelled pass (cleanupGrayscaleBuffers) or a plain display() must still show it.
+bool g_grayBaseStaged = false;
 
 bool lastPushUsedCleanBank() { return g_lastBaseEpdMode == lgfx::epd_mode::epd_text; }
 
@@ -302,7 +306,8 @@ void LgfxEpdDriver::display(EpdBus& bus, const uint8_t* fb, const uint8_t* prev,
   (void)bus;
   (void)prev;
 #if FREEINK_DRIVER_LGFX_EPD
-  fillCanvasBW(fb);  // expand the 1-bpp frame into the gray canvas
+  g_grayBaseStaged = false;  // this frame supersedes any staged gray base
+  fillCanvasBW(fb);          // expand the 1-bpp frame into the gray canvas
   const auto epdMode = epdModeFor(mode);
   if (epdMode == lgfx::epd_mode::epd_text) normalizeForCleanBank();
   g_lastBaseEpdMode = epdMode;
@@ -315,6 +320,26 @@ void LgfxEpdDriver::display(EpdBus& bus, const uint8_t* fb, const uint8_t* prev,
 #endif
 }
 
+void LgfxEpdDriver::beginGrayscale(EpdBus& bus, const uint8_t* fb, GrayscaleMode mode, RefreshMode fallback,
+                                   bool turnOff) {
+  (void)bus;
+  (void)mode;
+  (void)turnOff;  // displayGray() / cleanupGrayscaleBuffers() get their own turnOff
+#if FREEINK_DRIVER_LGFX_EPD
+  // Stage only: the same canvas fill and waveform choice display() makes, minus
+  // the push. normalizeForCleanBank() reads the PREVIOUS push's mode, so it runs
+  // before the new mode is recorded, exactly as in display().
+  fillCanvasBW(fb);
+  const auto epdMode = epdModeFor(fallback);
+  if (epdMode == lgfx::epd_mode::epd_text) normalizeForCleanBank();
+  g_lastBaseEpdMode = epdMode;
+  g_grayBaseStaged = true;
+#else
+  (void)fb;
+  (void)fallback;
+#endif
+}
+
 void LgfxEpdDriver::copyGrayscaleLsb(EpdBus& bus, const uint8_t* lsb) {
   (void)bus;
 #if FREEINK_DRIVER_LGFX_EPD
@@ -355,8 +380,9 @@ void LgfxEpdDriver::displayGray(EpdBus& bus, const uint8_t* fb, bool turnOff, co
   (void)lut;
   (void)factoryMode;
 #if FREEINK_DRIVER_LGFX_EPD
-  (void)fb;             // the canvas from the base push IS the base; see overlayCanvasGray()
+  (void)fb;             // the staged canvas IS the base; see overlayCanvasGray()
   overlayCanvasGray();  // darken only the pixels the planes select
+  g_grayBaseStaged = false;
   // Same mode as the B/W base push, and now actually the same: Panel_EPD's
   // per-pixel diff keys on the epd_mode LUT offset, so switching modes here
   // re-drives every pixel (full-screen flash). This was hardcoded to epd_fast
@@ -375,6 +401,12 @@ void LgfxEpdDriver::cleanupGrayscaleBuffers(EpdBus& bus, const uint8_t* bw) {
 #if FREEINK_DRIVER_LGFX_EPD
   if (!bw) return;
   fillCanvasBW(bw);
+  // A cancelled combined pass never showed its base: push the B/W page now, or
+  // the panel would keep the previous page while the app believes this one is up.
+  if (g_grayBaseStaged) {
+    g_grayBaseStaged = false;
+    pushCanvas(g_lastBaseEpdMode);
+  }
 #else
   (void)bw;
 #endif
diff --git a/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.h b/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.h
index 0646a9f..4310705 100644
--- a/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.h
+++ b/libs/display/FreeInkDisplay/src/driver/LgfxEpdDriver.h
@@ -41,10 +41,14 @@ class LgfxEpdDriver : public PanelDriver {
 
   // 16-gray path: the facade streams LSB/MSB 1-bpp planes (whole or in strips);
   // displayGray combines them with the B/W base into the panel's 8-bit gray canvas.
+  // Combined base: beginGrayscale() only stages the B/W frame in the canvas, and
+  // displayGray() pushes base + gray as ONE refresh. With a separate base every
+  // anti-aliased page took two full Panel_EPD refreshes (a visible double flash).
   GrayscaleCapabilities grayscaleCapabilities(GrayscaleMode mode = GrayscaleMode::Overlay) const override {
     if (mode != GrayscaleMode::Overlay) return {};
-    return {GrayscaleEncoding::OverlayMasks, GrayscaleBase::Separate, true, false, false};
+    return {GrayscaleEncoding::OverlayMasks, GrayscaleBase::Combined, true, false, false};
   }
+  void beginGrayscale(EpdBus& bus, const uint8_t* fb, GrayscaleMode mode, RefreshMode fallback, bool turnOff) override;
   void copyGrayscaleLsb(EpdBus& bus, const uint8_t* lsb) override;
   void copyGrayscaleMsb(EpdBus& bus, const uint8_t* msb) override;
   void writeGrayscalePlaneStrip(EpdBus& bus, GrayPlane plane, const uint8_t* rows, uint16_t yStart,
-- 
